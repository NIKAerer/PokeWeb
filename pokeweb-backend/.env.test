# Variables de l'environnement de test (utilisées par PHPUnit et la CI).
# Ce ne sont pas des secrets : les clés JWT de test sont générées à la volée
# par "php bin/console lexik:jwt:generate-keypair --env=test" et ne sont pas commitées.
KERNEL_CLASS='App\Kernel'
APP_SECRET='secret-de-test-uniquement'
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
JWT_PASSPHRASE=passphrase-de-test
